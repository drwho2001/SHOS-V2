# Free image-processing (vision) providers — fill in your own keys.
# Never commit this file. Copy to .env and fill values.
# Cloudflare Workers AI (free tier, 10k neurons/day)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Hugging Face Inference (free tier)
HF_TOKEN=
# Mistral (requires paid plan for API keys)
MISTRAL_API_KEY=
# OpenRouter (already configured separately)
OPENROUTER_API_KEY=
