# Template for the owner's private release keystore config.
# Copy this file to keystore.properties (gitignored) and fill in real values.
# Generate the keystore first:
#   keytool -genkey -v -keystore shos-release.jks -alias shos -keyalg RSA -keysize 2048 -validity 10000
# Then place shos-release.jks next to this file (android/app/) and set:
storeFile=shos-release.jks
storePassword=CHANGE_ME
keyAlias=shos
keyPassword=CHANGE_ME
