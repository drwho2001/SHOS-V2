<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_doxy_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DoxyPEP Window"
        android:textSize="16sp"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_doxy_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="No active window"
        android:textSize="18sp"
        android:textColor="@color/widget_warn"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_doxy_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted" />

    <!-- ADDED 9 Oct 2026 (t093) - the EVIDENCE line: the stored date of the
         encounter that opened the window, so the widget shows WHY a window
         exists, not just a bare countdown. A flat sibling, not a nested
         container (L-076: widget RemoteViews layouts inflate only one
         ViewGroup). Hidden at the Redacted tier by the provider, because an
         exposure DATE is identifying. -->
    <TextView
        android:id="@+id/widget_doxy_evidence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textSize="11sp"
        android:textColor="@color/widget_text_muted" />
</LinearLayout>