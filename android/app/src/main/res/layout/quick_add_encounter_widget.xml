<?xml version="1.0" encoding="utf-8"?>
<!-- Quick Add: Encounter.

     Same structure and the same measurement as quick_add_contact_widget.xml:
     the owner placed these at 108.7dp x 72dp - one launcher row, 40dp of
     content height at 16dp padding - so this layout uses 8dp padding, the
     icon is 22dp, and the label goes UNDERNEATH it rather than beside it
     (beside it, "Encounter" is about 59dp in a 48.7dp column and would break
     mid-word).

     ICON: the app's own shortcut disc in the Encounters module's colour, with
     the module's own pulse trace in white - the same mark the bottom nav
     draws for Encounters, which the owner named when they asked for these
     icons. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <!-- The icon is a PAIR: a white plus on the left and the Encounters module
         disc on the right, drawn as one vector (ic_widget_encounter.xml) so the
         two can never overlap and the pair centres as a unit whatever the
         card's width. -->
    <ImageView
        android:layout_width="33dp"
        android:layout_height="22dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_encounter" />

    <!-- maxLines 2, not 1: this label is a STATIC string, so there is no
         fit() call and no fitter to shrink it - maxLines is the only control
         on whether it ellipsizes. At one line it read "Log Enc..." on the
         device. Pinned by quickAddWidgetLabelGuard.test.js. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Log Encounter"
        android:textSize="12sp"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold"
        android:maxLines="2"
        android:breakStrategy="simple" />
</FrameLayout>
