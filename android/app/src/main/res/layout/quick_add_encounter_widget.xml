<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" android:background="@drawable/widget_background">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="Log encounter"
        android:src="@drawable/ic_widget_encounter" />

    <!-- CHANGED 16 Oct 2026 (t111) - maxLines 1 -> 2.

         DEVICE-MEASURED, not assumed. On 23124RA7EO this label rendered as
         "+ Log Enc..." with the rest of the word ellipsized away. The cause is
         not a measuring bug and nothing was shrunk: the text is a STATIC
         literal here, so this TextView has no android:id and the provider
         (QuickAddEncounterWidgetProvider) never calls WidgetTextFit.fit() -
         there is nothing to measure. Given a string wider than the 109dp
         2-column widget and maxLines=1, the label simply ellipsized.

         At maxLines=2 the label wraps onto two clean lines - "+ Log" /
         "Encounter" - because breakStrategy="simple" divides on spaces and
         every individual word is narrower than the field. ellipsize="end"
         stays, so a label ever made longer than two lines degrades gracefully
         rather than being cut mid-word.

         Guarded by quickAddWidgetLabelGuard.test.js; see the header of that
         file for why the sibling maxLines guard cannot see this view. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
         android:layout_gravity="bottom|center_horizontal"
         android:text="Log Encounter"
        android:textSize="12sp"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:breakStrategy="simple" />
</FrameLayout>
