<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_vaccine_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:gravity="center"
        android:text="Vaccination"
        android:textSize="16sp"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold"
        android:maxLines="1"
        android:breakStrategy="simple"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeStepGranularity="1sp" />

    <!-- Relative next-due date, e.g. "due in 14d" or "overdue 3d". -->
    <TextView
        android:id="@+id/widget_next_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="No vaccinations logged"
        android:textSize="20sp"
        android:textColor="@color/widget_text_muted"
        android:textStyle="bold"
        android:maxLines="2"
        android:breakStrategy="simple"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeStepGranularity="1sp" />

    <!-- Dose count: "3 doses" or "1 dose". -->
    <TextView
        android:id="@+id/widget_dose_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="70dp"
        android:gravity="center"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted"
        android:maxLines="1"
        android:breakStrategy="simple" />

</FrameLayout>
