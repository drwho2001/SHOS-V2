<?xml version="1.0" encoding="utf-8"?>
<!--
     EXPERIMENT (t118, 16 Oct 2026) - autoSizeTextType, on ONE widget.

     RE-LEARNED 21 Oct 2026 - the owner said this card "has some empty space"
     and that it did not say the next test is a ROUTINE one. Both are fixed
     here:

     - the empty space was the space BELOW the content: three small lines in a
       134dp-tall box. The date is now the card's hero (24sp, the one value a
       glance is for) and the rows are spread down the card rather than
       clustered at the top.
     - a new row says what kind of next test this is. "Retest due: 23 Dec" says
       WHEN; it does not say that the 23 Dec is the routine interval rather
       than an extra test for treatment. The provider fills this row only when
       the app's own routine-retest suggestion is what produced the date, so it
       never claims "routine" for a date that came from somewhere else.

     CLAUDE.md and lesson L-110 say autoSizeTextType "does not work in
     RemoteViews". THAT REASONING IS REFUTED, verified in the platform source at
     C:\Users\kanem\AppData\Local\Android\Sdk\sources\android-37.0\android\widget\
     TextView.java:
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_test_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:gravity="center"
        android:text="Last test"
        android:textSize="16sp"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold"
        android:maxLines="1"
        android:breakStrategy="simple"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeStepGranularity="1sp" />

    <!-- The date of the last test: the card's one value, so it is the biggest
         thing on it. -->
    <TextView
        android:id="@+id/widget_last_test"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="No tests logged"
        android:textSize="24sp"
        android:textColor="@color/widget_good"
        android:textStyle="bold"
        android:maxLines="1"
        android:breakStrategy="simple"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="24sp"
        android:autoSizeStepGranularity="1sp" />

    <!-- WHEN the next one is due. -->
    <TextView
        android:id="@+id/widget_retest_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="66dp"
        android:text="Retest due: —"
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted"
        android:maxLines="2"
        android:breakStrategy="simple" />

    <!-- WHAT KIND of next test it is. The provider fills this only when the
         app's own routine-retest suggestion produced the date, so it cannot
         claim "routine" for a date that came from somewhere else. -->
    <TextView
        android:id="@+id/widget_routine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="98dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted"
        android:maxLines="2"
        android:breakStrategy="simple" />
</FrameLayout>
