<?xml version="1.0" encoding="utf-8"?>
<!-- CHANGED 6 Oct 2026 - flattened. This was the ONLY one of the ten widget
     layouts containing a nested ViewGroup, and the only one containing a bare
     <View> divider; the other nine are all a single LinearLayout of at most four
     TextViews. The Clinic Card alone rendered as "Can't load widget" on a black
     background - in the widget picker AND on the home screen - while the other
     nine rendered correctly.

     The picker evidence is what makes this a LAYOUT fault rather than a provider
     or push-path fault: the picker inflates previewLayout in the launcher process
     without ever invoking the provider, so no Java in ClinicCardWidgetProvider can
     be responsible. That was measured, not assumed.

     Why this is a real change and not a probe: the nested row existed only so the
     sensitive fields could be hidden with ONE setViewVisibility call. That is a
     convenience, not a requirement - RemoteViews has no inverse selection either
     way, and hiding four named views individually is exactly what every other
     provider in this app already does. So flattening costs one extra call per
     branch and removes the only structural outlier.

     Verified before changing anything: every @drawable/@color/@string reference
     in all ten widget layouts and all ten widget_info.xml files resolves; all ten
     root elements are identical (LinearLayout, match_parent x match_parent,
     id=widget_root); both preview vector drawables are structurally identical;
     and there are no drawable-night variants at all, so a night-mode inflate
     failure is impossible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_clinic_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clinic Card"
        android:textSize="16sp"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_clinic_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="No upcoming appointment"
        android:textSize="14sp"
        android:textColor="@color/widget_good"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_clinic_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_accent"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_clinic_tests"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted" />

    <TextView
        android:id="@+id/widget_clinic_doctype"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted" />

    <TextView
        android:id="@+id/widget_clinic_clinic_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted" />

    <TextView
        android:id="@+id/widget_clinic_nhs_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted" />

    <TextView
        android:id="@+id/widget_clinic_reveal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textSize="11sp"
        android:textColor="@color/widget_accent"
        android:textStyle="bold" />
</LinearLayout>
