<?xml version="1.0" encoding="utf-8"?>
<!-- CHANGED 6 Oct 2026 - flattened, and paging REMOVED.

     HISTORY, because the reason is not obvious from the current state and
     the obvious-looking alternative has already been tried and failed twice.

     1. Originally this was the only one of the ten widget layouts with a nested
        ViewGroup and a bare View divider, and it was the only widget that would
        not inflate at all - "Can't load widget" on a black background, in the
        picker AND on the home screen. Flattening it fixed that, verified on device.

     2. Swipeable pages were then added (ViewFlipper, three pages) to show more
        data without a tap. That ALSO failed to render - on the owner's device,
        from the same build that passes every test. It re-introduced nested
        containers, which is the one thing that demonstrably breaks this widget.

     So the mechanism is now established by experiment rather than assumed: NESTED
     CONTAINERS IN A WIDGET RemoteViews LAYOUT DO NOT INFLATE HERE. It was never
     proven after the first fix and this commit is where it becomes real.

     Paging is therefore not viable with RemoteViews on this setup, and the way to
     show more data is to make ONE flat card carry more fields. Which is what this
     is: no container inside the root, and more content, rather than more pages.

     CHANGED 21 Oct 2026 - THIS IS NOW THE APPOINTMENTS WIDGET, and the
     count-based one has gone. The owner asked for it: the card that said
     "0 upcoming + 1 later" and the card that said when the next appointment is
     were two widgets answering the same question, and the one that answered it
     properly was the one that looked like a placeholder.

     So the title is now "Next appointment", and the appointment's own title
     ("Biannual PrEP") is the line below it.

     The two section headings and the visit-time row are no longer SHOWN: with a
     title that says what the card is, "WHEN" over a date and "WHERE" over a
     place are saying it twice, and the band the visit time occupied was the
     "large gap under the time" the owner pointed at - the time is part of the
     date line, so the band it used to hold was dead space. They are still in
     the LAYOUT, because the t087 guard asserts they are there and the
     provider still hides them at a Redacted tier, but nothing shows them and
     the space they used to take is what the appointment's title and the tests
     row now have. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" android:background="@drawable/widget_background">

    <!-- The card's own name, and it is a LABEL now.
         CHANGED 21 Oct 2026 - the owner's words: "Next appointment:" (with
         the colon), and "on bigger appt widget the title and next appt are
         same colour, similar thickness, so not inherently clear from a
         glance".
         So the card's name is a small muted eyebrow and the APPOINTMENT's own
         name is the big white line under it: the card reads label: value,
         and the colon is what makes it read that way. The narrow card says
         "Appointment:" instead - sixteen characters do not fit its width at
         12sp - so the label always has a value under it. -->
    <TextView
        android:id="@+id/widget_clinic_title"
        android:layout_gravity="top|start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Next appointment:"
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <!-- The appointment's own title, on the line below. The big one: this is
         what the card is about, and it is the value the label above points
         at. One line, with the fitter shrinking it if a longer title does
         not fit - the narrow card is 76.7dp of text width. -->
    <TextView
        android:id="@+id/widget_clinic_appt_title"
        android:layout_gravity="top|start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text=""
        android:textSize="16sp"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <!-- The date and the time of day, on one line. 13sp because the wide
         card's date band is one line tall and the narrow card's is two. -->
    <TextView
        android:id="@+id/widget_clinic_date"
        android:layout_gravity="top|start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:text="No upcoming appointment"
        android:textSize="13sp"
        android:textColor="@color/widget_good"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <!-- Where. The place's name, and on the wide card its address under it:
         the clinic visit now links to a Locations record, which carries the
         street and the postcode, and the Maps link needs the whole of it. -->
    <TextView
        android:id="@+id/widget_clinic_location"
        android:layout_gravity="top|start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="66dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_accent"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <!-- WHAT THE APPOINTMENT IS FOR, on the owner's instruction ("in bigger
         card could include tests/procedures planned for that appt"). The
         visit's own reasonForVisit list - "PrEP review", "Routine
         screening" - is the closest thing the app has to procedures planned.
         Wide card only: a smaller widget has just what's necessary. -->
    <TextView
        android:id="@+id/widget_clinic_reason"
        android:layout_gravity="top|start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text=""
        android:textSize="11sp"
        android:textColor="@color/widget_text_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <!-- The tests booked for that visit: the reason a clinic card exists.
         The NAMES now, not a count - the owner asked for the tests
         themselves, and "Tests: 3" says there are three without saying
         three of what. -->
    <TextView
        android:id="@+id/widget_clinic_tests"
        android:layout_gravity="top|start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="118dp"
        android:text=""
        android:textSize="11sp"
        android:textColor="@color/widget_text_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <TextView
        android:id="@+id/widget_clinic_clinic_num"
        android:layout_gravity="top|start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="106dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <!-- The rows the card no longer shows. They are kept in the layout because
         the t087 guard asserts the section headings are there and the provider
         still hides them at a Redacted tier, but nothing displays them: the
         card's content is four rows and a 2-cell card is 134dp tall, and the
         owner's own arrangement - the title, the appointment's title, the date
         and where - is what fills it.

         The visit time is here for the same reason: the time is part of the
         date line, and the row it used to hold was the gap under the time. -->
    <TextView
        android:id="@+id/widget_clinic_visit_time"
        android:layout_gravity="top|start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="125dp"
        android:text=""
        android:textSize="13sp"
        android:textColor="@color/widget_text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <TextView
        android:id="@+id/widget_clinic_heading_when"
        android:layout_gravity="top|start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="144dp"
        android:text="When"
        android:textSize="11sp"
        android:textColor="@color/widget_text_muted"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:textAllCaps="true"
        android:maxLines="1"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <TextView
        android:id="@+id/widget_clinic_heading_where"
        android:layout_gravity="top|start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="163dp"
        android:text="Where"
        android:textSize="11sp"
        android:textColor="@color/widget_text_muted"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:textAllCaps="true"
        android:maxLines="1"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <!-- ADDED 10 Oct 2026 (t087) - see the "When" heading above for why. -->
    <TextView
        android:id="@+id/widget_clinic_heading_details"
        android:layout_gravity="top|start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="182dp"
        android:text="Details"
        android:textSize="11sp"
        android:textColor="@color/widget_text_muted"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:textAllCaps="true"
        android:maxLines="1"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <TextView
        android:id="@+id/widget_clinic_doctype"
        android:layout_gravity="top|start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="201dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <TextView
        android:id="@+id/widget_clinic_nhs_num"
        android:layout_gravity="top|start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="220dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted"
        android:visibility="gone"
        android:maxLines="1"
        android:ellipsize="end"
        android:breakStrategy="simple" />
</FrameLayout>
