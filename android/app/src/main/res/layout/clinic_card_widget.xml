<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_clinic_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clinic Card"
        android:textSize="16sp"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_clinic_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="No upcoming appointment"
        android:textSize="14sp"
        android:textColor="@color/widget_good"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_clinic_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_accent"
        android:textStyle="bold"
        android:autoLink="map" />

    <TextView
        android:id="@+id/widget_clinic_tests"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted" />

    <LinearLayout
        android:id="@+id/widget_clinic_sensitive_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:visibility="gone"
        android:gravity="center">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_surface_alt" />

        <TextView
            android:id="@+id/widget_clinic_doctype"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="••••• tap to reveal"
            android:textSize="12sp"
            android:textColor="@color/widget_text_muted" />

        <TextView
            android:id="@+id/widget_clinic_clinic_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="••••• tap to reveal"
            android:textSize="12sp"
            android:textColor="@color/widget_text_muted" />

        <TextView
            android:id="@+id/widget_clinic_nhs_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="••••• tap to reveal"
            android:textSize="12sp"
            android:textColor="@color/widget_text_muted" />

        <TextView
            android:id="@+id/widget_clinic_reveal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tap to reveal sensitive info"
            android:textSize="11sp"
            android:textColor="@color/widget_accent"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>