<?xml version="1.0" encoding="utf-8"?>
<!-- ADDED 17 Oct 2026 - Next Dose widget rebuilt around a countdown ring.

     REWRITTEN 20 Oct 2026, and the header used to be wrong about the most
     important thing on the card. It said "HERE THE COUNTDOWN IS IN THE
     CENTRE", which was true of the layout and false of the widget: the
     countdown could not fit in the ring's hole at any legible size, so the
     provider put a status WORD there instead, and the number the owner wanted
     to see - the time - was nowhere.

     What the card shows now, and why:

       - the ring's centre carries the WALL-CLOCK DUE TIME ("04:00"), which is
         what the owner asked for and the only number that fits the 32dp hole
         (about 88px);
       - the live countdown is its own line beneath the ring, where the whole
         77dp of content width is available - the platform's format for it is
         "21:35:00" or "2d 21:35:00", and neither fits a hole this size;
       - the medication name is the caption, at the bottom.

     FrameLayout root, for the L-076 reason recorded in doxy_pep_widget.xml: one
     ViewGroup, children positioned with layout_gravity, no nesting. The bands
     do not have to sum to the widget height, so an overflowing eyebrow or a long
     medication name cannot push content off either end - which is exactly the
     defect that clipped this layout in the audit.

     The medication name has autosize rather than a fit() call. Once
     autoSizeTextType is on, TextView.setTextSize is a no-op (the framework guards
     it with !isAutoSizeEnabled()), so WidgetTextFit cannot shrink it and would
     only log a decision that never happened. It needs match_parent for the
     measure to be EXACTLY constrained, and gravity=center to keep looking
     centred once the view is full-width. The whole reason autosize works in
     RemoteViews at all is recorded in CLAUDE.md. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
         android:text="Next dose"
         android:textSize="16sp"
         android:textColor="@color/widget_text_primary"
         android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <!-- 50dp, moved UP to 26dp from the top of the card.
         The owner asked for both (20 Oct): the ring was "oversized" AND it
         left a band of dead space between the title and the ring. Moving it up
         closes that band, and growing it gives the countdown room - the
         platform's format ("34:45", or "6:18:35" for a dose hours away)
         measures 100px at 12sp on this device, which needs a 42dp hole
         (115px) to sit in with air around it.

         The drawable is innerRadius 21dp + thickness 4dp, so the hole is
         exactly 42dp and the drawable and the view are the same size - a
         shape drawable is drawn at its own size and CLIPPED if it is bigger. -->
    <ProgressBar
        android:id="@+id/widget_ring"
        style="@style/ShosWidgetRing"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="26dp"
        android:rotation="-90"
        android:max="100" />

    <!-- THE COUNTDOWN IS IN THE RING, and the fixed time is below it. That is
         the owner's instruction (20 Oct): the ring is the live thing - its
         sweep AND its number change every second - and the time it counts
         down to is a fixed fact that belongs lower down, where it reads as the
         answer to "when?".

         It is a real Chronometer, so it ticks in the launcher process with no
         app running, no alarm and no wake lock. The platform's format is the
         whole duration - "6:18:35" - because RemoteViews.setChronometer's
         format argument is a single-string template with one %s and the
         components cannot be selected; the owner said seconds are the least
         important part, which is what makes a seven-character number
         acceptable in the hole.

         The width is FIXED and equal to the ring's hole, which is what makes
         the autosize work: autoSize measures the view's own width, so a
         wrap_content view would measure its own text and could never shrink
         it. -->
    <Chronometer
        android:id="@+id/widget_countdown"
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="43dp"
        android:gravity="center"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeStepGranularity="1sp"
        android:clickable="false"
        android:focusable="false" />

    <!-- The status word, also in the ring's centre, for the two states where
         there is no countdown to show: DUE (a dose is due now) and OVERDUE.
         A Chronometer can render a static string - a format with no %s in it
         is used literally - but the two are different view types, so the
         provider shows one and hides the other. -->
    <TextView
        android:id="@+id/widget_ring_label"
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="43dp"
        android:gravity="center"
        android:text=""
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeStepGranularity="1sp" />

    <!-- The FIXED TIME, under the ring: "4:00am" is when the dose is due, and
         it does not change, so it is the caption under the ring rather than the
         number inside it. In the DUE and OVERDUE states this line carries the
         state instead ("Due now"). -->
    <TextView
        android:id="@+id/widget_next_dose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="80dp"
        android:text="--:--"
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <!-- The medication the time belongs to. Replaces the old 18sp hero: at 109dp
         an 18sp medication name is what produced "Sertralin e" broken mid-word,
         and a 2-cell box has room for one size of text, not two competing ones.

         The name is at 12sp with autosize down to 11sp, and the JS sends it as
         "Sertraline +2" rather than "Sertraline +2 more" - the full phrase is
         271px against the 211px this card has, so it ellipsized on the device.
         The count of the later doses is still on the card, which is what the
         owner's invariant asks for: anything that will alert must be visible
         here. -->
    <TextView
        android:id="@+id/widget_med_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="102dp"
        android:gravity="center"
        android:text="Medication"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:breakStrategy="simple"
        android:autoSizeTextType="uniform"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp" />
</FrameLayout>
