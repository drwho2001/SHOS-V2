<?xml version="1.0" encoding="utf-8"?>
<!-- ADDED 17 Oct 2026 - Next Dose widget rebuilt around a countdown ring.

     HERE THE COUNTDOWN IS IN THE CENTRE, as designed - unlike DoxyPEP. A daily
     dose is normally inside 24 hours, and the platform's format for that is
     "4:12:30": about 129px at 12sp against a 154px circle interior. It fits, with
     room for an eighth character. The same layout cannot show a 72-hour window
     (that is "2d 23:59:59", ~162px), which is why the DoxyPEP widget puts its
     countdown underneath its ring instead; the provider there hides the ring
     centre when the remaining time runs past 24 hours.

     FrameLayout root, for the L-076 reason recorded in doxy_pep_widget.xml: one
     ViewGroup, children positioned with layout_gravity, no nesting. The bands
     do not have to sum to the widget height, so an overflowing eyebrow or a long
     medication name cannot push content off either end - which is exactly the
     defect that clipped this layout in the audit.

     The medication name has autosize rather than a fit() call. Once
     autoSizeTextType is on, TextView.setTextSize is a no-op (the framework guards
     it with !isAutoSizeEnabled()), so WidgetTextFit cannot shrink it and would
     only log a decision that never happened. It needs match_parent for the
     measure to be EXACTLY constrained, and gravity=center to keep looking
     centred once the view is full-width. The whole reason autosize works in
     RemoteViews at all is recorded in CLAUDE.md. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:text="NEXT DOSE"
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted"
        android:maxLines="2"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <ProgressBar
        android:id="@+id/widget_ring"
        style="@style/ShosWidgetRing"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:rotation="-90"
        android:max="100" />

    <!-- THE COUNTDOWN IS NOT INSIDE THE RING, and that is a measured change from
         the design it started as. A 52dp ring leaves a 36dp interior - 99px at
         this device's density - and the shortest real countdown renders about
         116px wide in it. "4:12:30" therefore overflows the circle it is supposed
         to sit inside, and "2d 23:59:59" needs roughly 182px. There is no size
         at which a legible 12sp countdown fits inside a ring that also clears the
         caption block at the real 2-cell height.

         The ring shrank from 64dp to 52dp because at 64dp its lower edge landed
         20dp INSIDE the caption block at 166.55dp (115.3dp against a caption top
         of 95.6dp) - the ring was drawn across the medication name. Raising
         minResizeHeight instead would have made the 2-cell placement illegal and
         pushed the widget back to 3 cells, which is the size the owner deliberately
         moved away from.

         So the ring carries the STATUS WORD (short - "DUE", "NOW") and the live
         countdown is its own line beneath it. The number is still the thing that
         changes every second; it is just no longer pretending to be inside a
         circle it does not fit. The Chronometer stays, and it still ticks in the
         launcher process with no app running. -->
    <TextView
        android:id="@+id/widget_ring_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text=""
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <!-- The wall-clock dose time, ABOVE the medication name. It was originally
         placed at bottom|end beside it, and that was a real collision: the
         medication name is match_parent wide with centred text, so its view
         spans the whole bottom band and the time drew on top of it. In a
         FrameLayout children placed at the same gravity are stacked, not
         reflowed - there is no sibling axis to place them side by side, which is
         the cost of L-076 forbidding a second ViewGroup. Stacked, the ring
         still holds the centre and the two lines read as one caption. -->
    <!-- The live countdown, its own line. It used to sit inside the ring and
         could not fit there - see widget_ring_label's comment for the measurement.
         Still a real Chronometer, so it still ticks in the launcher process with no
         app running, no alarm and no wake lock. clickable/focusable false for the
         reason every other tap-target-adjacent view on this card states. -->
    <Chronometer
        android:id="@+id/widget_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="62dp"
        android:textSize="14sp"
        android:textColor="@color/widget_text_primary"
        android:clickable="false"
        android:focusable="false" />

    <TextView
        android:id="@+id/widget_next_dose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:text="--:--"
        android:textSize="12sp"
        android:textColor="@color/widget_text_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:breakStrategy="simple" />

    <!-- The medication the time belongs to. Replaces the old 18sp hero: at 109dp
         an 18sp medication name is what produced "Sertralin e" broken mid-word,
         and a 2-cell box has room for one size of text, not two competing ones. -->
    <TextView
        android:id="@+id/widget_med_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center"
        android:text="Medication"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:breakStrategy="simple"
        android:autoSizeTextType="uniform"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp" />
</FrameLayout>
