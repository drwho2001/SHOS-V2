<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_med_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Medication"
        android:textSize="16sp"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_next_dose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Next dose: --:--"
        android:textSize="14sp"
        android:textColor="@color/widget_text_muted" />

    <!-- CHANGED 2 Oct 2026 - a real Chronometer rather than a JS interval.
         The widget has updatePeriodMillis="0" because a medicine schedule is
         not a minute-resolution thing, so without this the countdown would tick
         once and then lie for the next hour. Chronometer is updated by the
         system UI, so it needs no alarm, no wake lock and no app process - the
         whole reason not to drive this from a setInterval on the JS side.

         setChronometerCountDown (rather than counting up) is what makes it read
         "in 4h 12m" towards the deadline instead of counting away from it. -->
    <Chronometer
        android:id="@+id/widget_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:textSize="14sp"
        android:textColor="@color/widget_text_primary" />
</LinearLayout>