<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_med_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Medication"
        android:textSize="16sp"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_next_dose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Next dose: --:--"
        android:textSize="14sp"
        android:textColor="@color/widget_text_muted" />

    <!-- CHANGED 2 Oct 2026 - a real Chronometer rather than a JS interval.
         The widget has updatePeriodMillis="0" because a medicine schedule is
         not a minute-resolution thing, so without this the countdown would tick
         once and then lie for the next hour. Chronometer is updated by the
         system UI, so it needs no alarm, no wake lock and no app process - the
         whole reason not to drive this from a setInterval on the JS side.

         setChronometerCountDown (rather than counting up) is what makes it read
         "in 4h 12m" towards the deadline instead of counting away from it.

         CHANGED 4 Oct 2026 - clickable/focusable stated explicitly. The root
         LinearLayout carries the click PendingIntent, and a Chronometer extends
         TextView; a TextView only consumes touches when something makes it
         clickable, so these are false by default. Stated because the failure is
         invisible if a later edit adds android:clickable="true": the countdown
         would become the one region of the widget that does nothing on tap.

         NOTE this comment sits ABOVE the tag, not inside it. An XML comment is
         not legal inside a tag's attribute list, and putting one there fails
         :app:parseDebugLocalResources with "Element type must be followed by
         either attribute specifications, '>' or '/>'". Same shape as the JSX
         `//`-in-children-position bug this repo has already recorded. -->
    <Chronometer
        android:id="@+id/widget_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:textSize="14sp"
        android:textColor="@color/widget_text_primary"
        android:clickable="false"
        android:focusable="false" />
</LinearLayout>