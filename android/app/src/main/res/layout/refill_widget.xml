<?xml version="1.0" encoding="utf-8"?>
<!-- Refills due.

     RE-LEARNED 21 Oct 2026: the owner said this card "has lots of empty
     space", and the empty space was the GAPS between the bands, not the card's
     height. The headline sat 42dp below the title and the body 45dp below that,
     so the three lines were spread over less than half the card and the rest
     was air.

     The bands are now close together and the HEADLINE - the one-word answer to
     "do I need to reorder?" - is the biggest thing on the card, because that
     is the thing being glanced at.

     AND THE COLOUR CARRIES THE MEANING (21 Oct 2026): "colour principle of
     useful information at first glance and then just muddled remainder isn't
     great". So the medication that needs reordering now is BRIGHT and
     everything else is DIM, which is two views - a view is one colour - and
     the two share the card's six lines. The dim group starts with a blank
     line, which is the gap between the bright medication and the rest.

     The two views' maxLines are 2 and 4, so the card's capacity is six lines
     - the same six the JS builds to. widgetRefillCardBudgetGuard.test.js
     checks that they agree. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_refill_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:text="Refills due"
        android:textSize="16sp"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold"
        android:maxLines="1"
        android:breakStrategy="simple" />

    <!-- The headline: "Soon" or "None". The provider recolours it - amber when
         something is due, green when nothing is - so the state is carried by the
         word AND by its colour, never by colour alone.

         20sp, not 24sp, and that is arithmetic rather than taste. The body
         under it needs six lines of 11sp - 80dp - and the title above it takes
         19dp, so the three bands together are 124dp of a 131dp card. A 24sp
         headline would need 29dp of that, leaving nothing for the gaps, and the
         gaps are what stop the bands reading as one block of text. -->
    <TextView
        android:id="@+id/widget_refill_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="22dp"
        android:text="None"
        android:textSize="20sp"
        android:textColor="@color/widget_good"
        android:textStyle="bold"
        android:maxLines="1"
        android:breakStrategy="simple" />

    <!-- THE MEDICATIONS THAT NEED ACTION NOW, and then the rest.

         The owner's colour principle (21 Oct 2026): "colour principle of
         useful information at first glance and then just muddled remainder
         isn't great". So the medication that needs reordering is BRIGHT and
         everything else is dim - the same split the other cards make with
         their headline, and it is why this is two views rather than one: a
         single TextView is a single colour, and interleaving a name and its
         state in one string cannot mark which one matters.

         The two views SHARE the card's six lines (the guard says so), so a
         card with two medications still fits. -->
    <TextView
        android:id="@+id/widget_refill_due"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="47dp"
        android:text=""
        android:textSize="11sp"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold"
        android:maxLines="2"
        android:breakStrategy="simple" />

    <!-- Everything else: the medications that are not due yet, dim, and a
         last line saying how many are not shown. -->
    <TextView
        android:id="@+id/widget_next_refill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="75dp"
        android:text=""
        android:textSize="11sp"
        android:textColor="@color/widget_text_muted"
         android:maxLines="4"
        android:breakStrategy="simple" />
</FrameLayout>
