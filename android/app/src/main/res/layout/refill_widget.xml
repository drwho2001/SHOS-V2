<?xml version="1.0" encoding="utf-8"?>
<!-- Refills due.

     RE-LEARNED 21 Oct 2026: the owner said this card "has lots of empty
     space", and the empty space was the GAPS between the bands, not the card's
     height. The headline sat 42dp below the title and the body 45dp below that,
     so the three lines were spread over less than half the card and the rest
     was air.

     The bands are now close together and the HEADLINE - the one-word answer to
     "do I need to reorder?" - is the biggest thing on the card, because that
     is the thing being glanced at. "Soon" in 24sp says more in a glance than
     "Soon" in 18sp, and the per-medication lines under it are the detail.

     The body's own maxLines is 4, so a card with four medications tracked fills
     the space and one with a single medication does not - which is the truth
     about the data rather than a layout trying to invent content. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_refill_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:text="Refills due"
        android:textSize="16sp"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold"
        android:maxLines="1"
        android:breakStrategy="simple" />

    <!-- The headline: "Soon" or "None". The provider recolours it - amber when
         something is due, green when nothing is - so the state is carried by the
         word AND by its colour, never by colour alone.

         20sp, not 24sp, and that is arithmetic rather than taste. The body
         under it needs six lines of 11sp - 80dp - and the title above it takes
         19dp, so the three bands together are 124dp of a 131dp card. A 24sp
         headline would need 29dp of that, leaving nothing for the gaps, and the
         gaps are what stop the bands reading as one block of text. -->
    <TextView
        android:id="@+id/widget_refill_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="22dp"
        android:text="None"
        android:textSize="20sp"
        android:textColor="@color/widget_good"
        android:textStyle="bold"
        android:maxLines="1"
        android:breakStrategy="simple" />

    <!-- The per-medication lines: name, what is left, and what has happened.

         SIX lines at 11sp, and the reason is the width: this card is 76.7dp
         across, which is about 13 characters a line at 11sp. "Sertraline - 14
         left - requested" is 29 characters, so it wraps onto three lines - and
         the medication below it needs three more. The JS now sends one fact per
         line, so each medication spends exactly three lines and two
         medications fill the card.

         The body starts at 48dp because the headline above it ends at 46dp: the
         card is 131dp tall inside its padding, and six lines of 11sp are 80dp,
         so 48 + 80 = 128 leaves three dp of slack. That slack is what stops
         the last line being clipped - the card was measured with its last line
         cut off, and the fix was to spend the space the headline was wasting,
         not to shorten the text. -->
    <TextView
        android:id="@+id/widget_next_refill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="48dp"
        android:text=""
        android:textSize="11sp"
        android:textColor="@color/widget_text_muted"
         android:maxLines="6"
        android:breakStrategy="simple" />
</FrameLayout>
