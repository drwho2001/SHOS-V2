<?xml version="1.0" encoding="utf-8"?>
<!-- ADDED 3 Oct 2026 - one shape for all ten widgets. Rounded, because a widget
     with square corners reads as a hole cut in the wallpaper; 16dp matches the
     card radius the rest of the app uses. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_bg" />
    <corners android:radius="16dp" />
</shape>
