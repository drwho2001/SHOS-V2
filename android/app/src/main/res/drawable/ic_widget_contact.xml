<!-- Quick Add: Users.

     THE ICON IS THE APP'S OWN PHOSPHOR "Users" GLYPH, in white on the
     module's disc - the owner asked for the phosphor icons (21 Oct). The path is
     the real one out of @phosphor-icons/react 2.1.10, regular weight: the
     module's own mark in the bottom nav.

     THE GLYPH IS SCALED TO FIT AND CENTRED IN THE DISC, and that is the part
     that had to be measured rather than assumed. A phosphor icon is drawn on a
     256-unit grid and its mark is NOT centred in that grid - "Users" is a wide
     pair of people whose ink sits 13 units right of centre and 26 below it, so
     centring the GRID puts the people half outside the disc.

     So the scale and the offset come from the glyph's own measured bounding
     box: the path is walked (arcs sampled, because an arc's endpoints do not
     bound it) and the mark is scaled to fit inside the disc with a margin, then
     moved so the middle of the INK lands on the middle of the disc.

     THE ADD BADGE IS SEPARATE, WHITE, AND TO THE LEFT of the disc (the owner's
     instruction, 20 Oct: the plus was "compacted over" the module icon;
     decompact it, put it to the left, and make it white). White because it sits
     on the CARD's teal background rather than on the disc. It is on the disc's
     centre line, so the pair is level.

     The pair - plus, then disc - is centred as a unit by the layout. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="33dp"
    android:height="22dp"
    android:viewportWidth="256"
    android:viewportHeight="170">
    <!-- The add badge, in white. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M33,67H55V78H62V92H55V103H33V92H26V78H33Z" />
    <!-- The module disc. -->
    <path
        android:fillColor="#00796B"
        android:pathData="M160,15A70,70 0,1 0,160,155A70,70 0,1 0,160,15Z" />
    <!-- Phosphor "Users", regular weight, in white, scaled to fit the disc
         and centred on the ink's own middle. -->
    <group
        android:scaleX="0.4415"
        android:scaleY="0.4415"
        android:translateX="97.73"
        android:translateY="17.08">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M117.25,157.92a60,60,0,1,0-66.5,0A95.83,95.83,0,0,0,3.53,195.63a8,8,0,1,0,13.4,8.74,80,80,0,0,1,134.14,0,8,8,0,0,0,13.4-8.74A95.83,95.83,0,0,0,117.25,157.92ZM40,108a44,44,0,1,1,44,44A44.05,44.05,0,0,1,40,108Zm210.14,98.7a8,8,0,0,1-11.07-2.33A79.83,79.83,0,0,0,172,168a8,8,0,0,1,0-16,44,44,0,1,0-16.34-84.87,8,8,0,1,1-5.94-14.85,60,60,0,0,1,55.53,105.64,95.83,95.83,0,0,1,47.22,37.71A8,8,0,0,1,250.14,206.7Z" />
