<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- FIXED — real device bug: this theme never set its own system
         bar colors, so it fell back to Theme.AppCompat's default
         (opaque, light) status bar and navigation bar. That was
         invisible while the WebView drew inside its own bounds below
         those bars — but Android now enforces edge-to-edge for apps
         targeting SDK 35+ (this app targets 36, see variables.gradle),
         so the WebView draws behind both bars regardless, and their
         still-opaque default backgrounds showed as a plain white strip
         over the app's own themed header/nav bar. Transparent here
         lets the app's own CSS (env(safe-area-inset-top/bottom),
         already wired up on every screen) show through cleanly instead
         of a mismatched opaque band. -->
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>


    <!-- The theme MainActivity actually runs under (see
         AndroidManifest.xml's android:theme on that activity) — the
         transparent bar colors have to live here too, not just on the
         other themes above, or this real device bug isn't actually
         fixed. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- ADDED 17 Oct 2026 - the countdown ring's ProgressBar.

         It must inherit the HORIZONTAL style, because an unstyled ProgressBar is
         the circular indeterminate one and would render a spinner where the ring
         should be. But Widget.ProgressBar.Horizontal carries android:maxHeight
         (a few dp, sized for a 4dp line), and this bar is a 64dp ring - the
         constraint squashes it to a sliver rather than being ignored.

         maxHeight/minHeight of 0dp removes the cap. It cannot simply be omitted:
         ProgressBar's own initProgressBar() falls back to a default height when
         both are unset, which is not 64dp either. Explicit 0dp, and the 64dp box
         comes from the view's own layout_width/height in the widget layout. -->
    <style name="ShosWidgetRing" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/widget_ring</item>
        <item name="android:maxHeight">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:indeterminateOnly">false</item>
    </style>
</resources>