<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ADDED — needed for @capacitor/filesystem's Directory.Documents
         write (see fileExportHelper.js's export-a-copy-to-public-storage
         fix) to actually work on older Android. Capped at maxSdkVersion
         per Capacitor's own documented convention: WRITE_EXTERNAL_STORAGE
         has no effect at all beyond API 28 (scoped storage replaces it),
         and READ_EXTERNAL_STORAGE stops mattering once granular media
         permissions arrive at API 33 — declaring either uncapped would
         just be a stale, unused grant on modern Android, not a real
         capability. Android 11+ (the realistic case for this app) writes
         its own created files into Documents via MediaStore without
         needing either permission. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- ADDED — real ask: "use current location" on Contacts/Encounters,
         via @capacitor/geolocation. The plugin itself requires at least
         ACCESS_COARSE_LOCATION declared here to even ask for the
         runtime permission (confirmed via its own real error message,
         same lesson as the Filesystem permissions above) — FINE is
         also declared since Android 12+'s own system dialog already
         lets the user choose "approximate" vs "precise" themselves at
         grant time either way, so declaring both just means the choice
         is genuinely theirs rather than this app pre-deciding it. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
